# =================================================================
# SkillGraph AI — Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# =================================================================

# Application
PROJECT_NAME="SkillGraph AI"
VERSION="1.0.0"

# Database Configuration
# Default is local SQLite for zero-friction setup:
DATABASE_URL="sqlite:///./skillgraph.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/skillgraph_db"

# Security & Session Authentication
SECRET_KEY="replace-with-a-random-32-byte-hex-string-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Official Google Gemini AI Configuration
# When left empty, SkillGraph AI runs in deterministic development mode with full fidelity
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
